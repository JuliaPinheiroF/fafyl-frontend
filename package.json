{
  "name": "fafyl",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "EXPO_PUBLIC_ENV=development expo start",
    "dev:android": "EXPO_PUBLIC_ENV=development expo start --android",
    "dev:ios": "EXPO_PUBLIC_ENV=development expo start --ios",
    "prod": "EXPO_PUBLIC_ENV=production expo start",
    "prod:android": "EXPO_PUBLIC_ENV=production expo start --android",
    "prod:ios": "EXPO_PUBLIC_ENV=production expo start --ios",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "hooks:install": "bash scripts/install-hooks.sh",
    "postinstall": "bash scripts/install-hooks.sh"
  },
  "dependencies": {
    "@expo-google-fonts/alfa-slab-one": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "^57.0.23",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
