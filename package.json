{
  "name": "fafyl",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "local": "EXPO_PUBLIC_ENV=local expo start",
    "local:android": "EXPO_PUBLIC_ENV=local expo start --android",
    "local:ios": "EXPO_PUBLIC_ENV=local expo start --ios",
    "prod": "EXPO_PUBLIC_ENV=production expo start",
    "prod:android": "EXPO_PUBLIC_ENV=production expo start --android",
    "prod:ios": "EXPO_PUBLIC_ENV=production expo start --ios",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "hooks:install": "bash scripts/install-hooks.sh",
    "postinstall": "bash scripts/install-hooks.sh"
  },
  "dependencies": {
    "@expo-google-fonts/alfa-slab-one": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "^58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
